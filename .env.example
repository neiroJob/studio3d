# Настройки Студии 3D. Скопируйте в .env и заполните:
#   cp .env.example .env
# или запустите ./install.sh — он создаст .env и сгенерирует секреты сам.
# Файл .env в git не коммитится.

# Секретный ключ Django: длинная случайная строка.
# Сгенерировать: openssl rand -base64 48
SECRET_KEY=

# База данных PostgreSQL
DATABASE_NAME=studio3d
DATABASE_USER=studio3d
# Пароль БД. Сгенерировать: openssl rand -hex 24
DATABASE_PASSWORD=

# Порт веб-интерфейса на сервере (80 — открывается просто по IP)
HTTP_PORT=80

# Часовой пояс студии по умолчанию (меняется в мастере первого запуска и в настройках)
TIME_ZONE=Europe/Moscow

# Сессия без «запомнить меня», часов
SESSION_HOURS=12
# Сессия с «запомнить меня на этом устройстве», дней
REMEMBER_DAYS=30

# Защита входа: после N неудачных попыток вход с IP блокируется на M минут
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=5

# Как часто обновлять превью камер на дашборде и в карточке принтера, сек
CAMERA_REFRESH_SECONDS=10

# Резервные копии БД: время ежесуточного дампа (ЧЧ:ММ) и срок хранения, дней.
# Файлы кладутся в папку backups/ рядом с docker-compose.yml.
BACKUP_TIME=03:30
BACKUP_KEEP_DAYS=14

# Отладка. В студии всегда 0.
DEBUG=0
